#!/bin/sh

# Run spell checker and linters.

set -e


# Temporary storage. Double quotes will trap the current variable value.
# shellcheck disable=SC2064
{
    d=$(mktemp -d "/tmp/$(basename "$0").XXXXXX")
    trap "rm -rf -- '$d'" EXIT
    trap exit INT TERM
}


# Relevant files. BusyBox's `awk` cannot print null characters.
list() { git diff -z --staged --name-only --diff-filter=ACMRT -- "$@" ; }
staged="$d/staged"
markdown="$d/md"
yaml="$d/yaml"
shell="$d/shell"
list                     >"$staged"
list '*.yaml' '*.yml'    >"$yaml"
list '*.md' '*.markdown' >"$markdown"
xargs -0r file <"$staged" |
    awk '/shell script/ { sub(/:[^:]*$/, ""); print }' |
    tr '\n' '\0' >"$shell"


# Staged tree. For partial commits, do not run tests on working tree.
git checkout-index --prefix="$d/tree/" -a
cd "$d/tree"


if [ -s "$staged" ]; then
    echo "Running spell checker"
    xargs -0 typos <"$staged"
fi

if [ -s "$markdown" ]; then
    echo "Running Markdown linter"
    xargs -0 pymarkdown scan <"$markdown"
fi

if [ -s "$yaml" ]; then
    echo "Running YAML linter"
    xargs -0 yamllint -s <"$yaml"
fi

if [ -s "$shell" ]; then
    echo "Running shell linter"
    xargs -0 shellcheck <"$shell"
fi
